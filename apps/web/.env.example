# MyStake web (Next.js) — copy to .env.local and fill in.
# Never commit real secrets.

# Base URL of the FastAPI coach/backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (Phase 1) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: required for owner bootstrap + admin mutations from Next.js
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Google emails that auto-receive allowlist + admin on first sign-in
OWNER_EMAILS=
