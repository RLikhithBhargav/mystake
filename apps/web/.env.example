# MyStake web (Next.js) — local env template. Copy to .env.local and fill in.
# No secrets are committed. Phase 0 needs none of these to boot.

# Base URL of the FastAPI coach/backend (Phase 0+)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (added in Phase 1 — leave blank for Phase 0)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
