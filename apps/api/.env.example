# MyStake API (FastAPI) — copy to .env and fill in.
# Never commit real secrets.

SERVICE_NAME=mystake-api
# Comma-separated CORS origins allowed to call the API (the web app).
CORS_ORIGINS=http://localhost:3000

# Phase 3 — Postgres quote cache via Supabase (recommended for shared/dev)
# If unset, quotes use an in-process memory cache (fine for local solo testing).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Quote TTL seconds (default 600 = 10 minutes)
QUOTE_CACHE_TTL_SECONDS=600

# Optional US adapter; Yahoo is used for US+IN when unset / on failure
ALPHA_VANTAGE_API_KEY=

# Later phases:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# LANGSMITH_API_KEY=
