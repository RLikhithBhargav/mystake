# MyStake API (FastAPI) — copy to .env and fill in.
# Never commit real secrets.

SERVICE_NAME=mystake-api
CORS_ORIGINS=http://localhost:3000

# Supabase — quotes cache, coach portfolio load/persist, JWT user lookup
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

QUOTE_CACHE_TTL_SECONDS=600
ALPHA_VANTAGE_API_KEY=

# Phase 4 — LLM (OpenAI primary → OpenRouter fallback). Optional: deterministic coach runs without keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# LangSmith tracing/evals only (not LangGraph Platform hosting)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mystake

# Set true only for local smokes that POST use_seed_portfolio
COACH_ALLOW_SEED_PORTFOLIO=false
