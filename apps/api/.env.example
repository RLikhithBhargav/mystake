# MyStake API (FastAPI) — local env template. Copy to .env and fill in.
# No secrets are committed. Phase 0 needs none of these to boot.

SERVICE_NAME=mystake-api
# Comma-separated CORS origins allowed to call the API (the web app).
CORS_ORIGINS=http://localhost:3000

# Added in later phases (leave blank for Phase 0):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# LANGSMITH_API_KEY=
