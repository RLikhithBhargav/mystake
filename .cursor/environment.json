{
  "name": "MyStake",
  "install": "bash scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd apps/api && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "description": "FastAPI backend (http://localhost:8000, docs at /docs, health at /health)."
    },
    {
      "name": "web",
      "command": "cd apps/web && pnpm dev",
      "description": "Next.js web app (http://localhost:3000)."
    }
  ],
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "api", "port": 8000 }
  ]
}
